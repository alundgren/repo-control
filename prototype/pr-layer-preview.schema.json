{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pull request review plan",
  "description": "A generated explanation of one pull request, read alongside current GitHub pull request data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedFor", "overview", "sections"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "generatedFor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "pullRequestNumber", "baseCommit", "headCommit", "generatedAt"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "pullRequestNumber": { "type": "integer", "minimum": 1 },
        "baseCommit": { "type": "string", "minLength": 7 },
        "headCommit": { "type": "string", "minLength": 7 },
        "generatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "overview": { "type": "string", "minLength": 1, "maxLength": 1200 },
    "sections": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/section" } }
  },
  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "summary", "dependsOn", "signals", "anchors", "files"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 600 },
        "dependsOn": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "signals": { "type": "array", "maxItems": 6, "items": { "type": "string", "maxLength": 80 } },
        "anchors": { "type": "array", "minItems": 1, "maxItems": 60, "items": { "$ref": "#/$defs/anchor" } },
        "files": { "type": "array", "minItems": 1, "maxItems": 60, "items": { "$ref": "#/$defs/file" } }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "additions", "deletions"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "additions": { "type": "integer", "minimum": 0 },
        "deletions": { "type": "integer", "minimum": 0 }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "startLine", "endLine"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
