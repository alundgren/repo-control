{
  "name": "repo-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "24.x",
    "pnpm": "11.22.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "browser:install": "vp exec playwright install chromium webkit",
    "build": "vp exec tsc --noEmit && vp build && vp exec tsc --project tsconfig.server.json",
    "lint": "vp exec eslint .",
    "start": "vp exec node dist/server/main.js",
    "test": "vp exec node scripts/run-tests.mjs",
    "test:browser": "vp exec node scripts/run-tests.mjs browser",
    "test:focused": "vp exec node scripts/run-focused-test.mjs",
    "typecheck": "vp exec tsc --noEmit",
    "verify:container": "vp exec node scripts/verify-container.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.1",
    "pino": "^10.3.1",
    "qrcode-generator": "1.4.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.2.0",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "globals": "^17.3.0",
    "jsdom": "28.1.0",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vite-plus": "0.3.0",
    "vitest": "4.1.11"
  }
}
